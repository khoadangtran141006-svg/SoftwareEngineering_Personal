PORT=3001
DATABASE_URL=postgresql://postgres:change-this-password@localhost:5432/brewlite_db
DB_NAME=brewlite_db
DB_USERNAME=postgres
DB_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development
# Địa chỉ giao diện được phép gọi API (CORS), có thể nhiều địa chỉ ngăn cách bằng dấu phẩy
# FRONTEND_URL=http://localhost:3000
# Địa chỉ API mà trình duyệt gọi (được nhúng lúc build frontend)
# NEXT_PUBLIC_API_URL=http://localhost:3001
# Bảo mật: giới hạn số request mỗi phút cho mỗi IP (mặc định 200) và riêng cho đăng nhập/đăng ký/quên mật khẩu (mặc định 10)
# RATE_LIMIT_PER_MINUTE=200
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Chạy sau reverse proxy (Render, Nginx): đặt 1 để lấy đúng IP người dùng
# TRUST_PROXY=1
# Đơn chưa thanh toán tự hủy (và hoàn kho) sau số phút này; đặt 0 để tắt
ORDER_EXPIRY_MINUTES=15
# Tài khoản barista để demo đổi trạng thái đơn (để trống nếu không cần)
STAFF_EMAIL=staff@brewlite.local
STAFF_PASSWORD=change-this-staff-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
